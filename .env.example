# Trogix — environment
#
# Copy to .env.local for development. In production these are set in the
# Vercel project (Settings → Environment Variables), not in a file.
#
# Variables prefixed NEXT_PUBLIC_ are compiled into the browser bundle and are
# public by definition. Everything else is server-only — never expose it, and
# never add a NEXT_PUBLIC_ prefix to any of them.
#
# Check a deployment with GET /api/health — it reports which groups are
# configured without printing any value.


# ─────────────────────────────────────────────────────────── REQUIRED ──
# The app will not function without every variable in this section.

# Postgres connection string.
# Supabase → Project Settings → Database → Connection string → URI.
# Use the CONNECTION POOLER (port 6543) for the app: serverless functions open
# many short-lived connections and would exhaust the direct pool.
# Append ?pgbouncer=true as Supabase recommends.
# Keep the direct connection (port 5432) for running migrations only.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase project API settings.
# Supabase → Project Settings → API. The anon key is safe in the browser;
# row level security and column grants are what protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 32-byte server secret. Generate with:  openssl rand -base64 32
# Used for two things:
#   1. AES-256-GCM encryption of restaurant Razorpay tokens at rest
#   2. the HMAC that hashes verification codes and signs the pending-signup cookie
# Rotating it invalidates stored gateway tokens (restaurants must reconnect)
# and live verification codes (owners request a new one). Never reuse a
# Supabase key here.
APP_ENCRYPTION_KEY=

# Public origin of this deployment, no trailing slash.
# Used to build the Razorpay OAuth redirect URI and the QR menu links printed
# on table cards. It must match the domain guests actually visit.
NEXT_PUBLIC_APP_URL=https://trogix.co.in

# Resend — the only email provider. Required: the signup verification code is
# delivered by email, so signup cannot complete without it.
# resend.com → API Keys. EMAIL_FROM must be an address on a domain you have
# verified in Resend, otherwise every send is rejected.
RESEND_API_KEY=re_
EMAIL_FROM=Trogix <verify@trogix.co.in>


# ─────────────────────────────────────────────────────────── OPTIONAL ──
# The app runs without these; the named capability is unavailable until set.

# Razorpay Connect (the Trogix partner application).
# Without these a restaurant cannot connect its own merchant account, and
# orders fall back to pay-at-counter. Customer money always moves directly to
# the restaurant's Razorpay account — Trogix never holds funds.
RAZORPAY_CLIENT_ID=
RAZORPAY_CLIENT_SECRET=
# Signing secret for the webhook endpoint you register at
# https://YOUR_DOMAIN/api/webhooks/razorpay — events with a bad signature are
# rejected and logged rather than processed.
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp Cloud API for guest order updates. Without these, messages are
# recorded as "skipped" instead of being sent; orders are unaffected.
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ──────────────────────────────────────────────────────── LOCAL PREVIEW ──
# Opens every owner-side screen with no account, no database and no Supabase
# project: the guards return a stand-in owner and each query returns the demo
# restaurant in lib/preview/data.ts.
#
#   TROGIX_PREVIEW=1     in .env.local, then `npm run dev`
#
# Leave it unset everywhere else. It is ignored outright on a Vercel
# production deployment, so it cannot open a live site by accident. Saving
# still writes to the real database, so buttons that save fail while it is on.
TROGIX_PREVIEW=
